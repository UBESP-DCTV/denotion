source("renv/activate.R")

options(
  warnPartialMatchArgs = TRUE,
  warnPartialMatchAttr = TRUE,
  warnPartialMatchDollar = TRUE
)

if (interactive()) {
  suppressPackageStartupMessages(suppressWarnings({
    require(devtools)
    require(renv)
    require(targets)
    require(testthat)
    require(usethis)
  }))
}
